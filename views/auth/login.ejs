<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Login - Techkart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <button type="button" id="theme-toggle" class="theme-toggle-btn theme-toggle-standalone" aria-label="Toggle dark mode" title="Toggle dark mode">&#127769;</button>

    <main>
        <h1>Login to Techkart</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red;">
                <%= error %>
            </p>
            <% } %>
                <% if (typeof message !=='undefined' && message) { %>
                    <p style="color: green;">
                        <%= message %>
                    </p>
                    <% } %>

                        <form action="/login" method="POST">
                            <div>
                                <label for="email">Email Address:</label>
                                <input type="email" id="email" name="email" required placeholder="name@example.com"
                                    value="<%= typeof email !== 'undefined' ? email : '' %>">
                            </div>

                            <div>
                                <label for="password">Password:</label>
                                <input type="password" id="password" name="password" required
                                    placeholder="Enter password">
                            </div>

                            <div>
                                <input type="checkbox" id="remember" name="remember">
                                <label for="remember">Remember me</label>
                            </div>

                            <button type="submit">Login</button>
                        </form>

                        <p>Don't have an account? <a href="/register">Register here</a></p>
                        <p><a href="/">Back to Home</a></p>
    </main>    <script src="/script.js" defer></script>
</body>

</html>