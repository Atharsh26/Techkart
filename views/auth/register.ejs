<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Techkart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <button type="button" id="theme-toggle" class="theme-toggle-btn theme-toggle-standalone" aria-label="Toggle dark mode" title="Toggle dark mode">&#127769;</button>

    <main>
        <h1>Create Techkart Account</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red;">
                <%= error %>
            </p>
            <% } %>

                <form action="/register" method="POST">
                    <div>
                        <label for="name">Full Name:</label>
                        <input type="text" id="name" name="name" required placeholder="John Doe"
                            value="<%= typeof name !== 'undefined' ? name : '' %>">
                    </div>

                    <div>
                        <label for="email">Email Address:</label>
                        <input type="email" id="email" name="email" required placeholder="name@example.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>">
                    </div>

                    <div>
                        <label for="phone">Phone Number:</label>
                        <input type="tel" id="phone" name="phone" required placeholder="9876543210"
                            value="<%= typeof phone !== 'undefined' ? phone : '' %>">
                    </div>

                    <div>
                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password" required placeholder="Create password">
                    </div>

                    <div>
                        <label for="confirmPassword">Confirm Password:</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required
                            placeholder="Confirm password">
                    </div>

                    <div>
                        <input type="checkbox" id="terms" required checked>
                        <label for="terms">I agree to the terms and conditions</label>
                    </div>

                    <button type="submit">Register</button>
                </form>

                <p>Already have an account? <a href="/login">Login here</a></p>
                <p><a href="/">Back to Home</a></p>
    </main>    <script src="/script.js" defer></script>
</body>

</html>