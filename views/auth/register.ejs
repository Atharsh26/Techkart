<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Techkart</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <main>
        <h1>Create Techkart Account</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red;">
                <%= error %>
            </p>
            <% } %>

                <form action="/register" method="POST">
                    <div>
                        <label for="name">Full Name:</label>
                        <input type="text" id="name" name="name" required placeholder="John Doe"
                            value="<%= typeof name !== 'undefined' ? name : '' %>">
                    </div>

                    <div>
                        <label for="email">Email Address:</label>
                        <input type="email" id="email" name="email" required placeholder="name@example.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>">
                    </div>

                    <div>
                        <label for="phone">Phone Number:</label>
                        <input type="tel" id="phone" name="phone" required placeholder="9876543210"
                            value="<%= typeof phone !== 'undefined' ? phone : '' %>">
                    </div>

                    <div>
                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password" required placeholder="Create password">
                    </div>

                    <div>
                        <label for="confirmPassword">Confirm Password:</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required
                            placeholder="Confirm password">
                    </div>

                    <div>
                        <input type="checkbox" id="terms" required checked>
                        <label for="terms">I agree to the terms and conditions</label>
                    </div>

                    <button type="submit">Register</button>
                </form>

                <p>Already have an account? <a href="/login">Login here</a></p>
                <p><a href="/">Back to Home</a></p>
    </main>

</body>

</html>