<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Techkart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <button type="button" id="theme-toggle" class="theme-toggle-btn theme-toggle-standalone" aria-label="Toggle dark mode" title="Toggle dark mode">&#127769;</button>

    <main>
        <h1>Techkart Admin Portal</h1>
        <p>Authorized personnel only</p>

        <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red;">
                <%= error %>
            </p>
            <% } %>

                <form action="/admin/login" method="POST">
                    <div>
                        <label for="email">Admin Email / Username:</label>
                        <input type="text" id="email" name="email" required placeholder="admin@techkart.com"
                            value="<%= typeof email !== 'undefined' ? email : '' %>">
                    </div>

                    <div>
                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password" required placeholder="Enter password">
                    </div>

                    <button type="submit">Access Dashboard</button>
                </form>

                <p><a href="/">Back to Storefront</a></p>
    </main>    <script src="/script.js" defer></script>
</body>

</html>