<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Techkart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Admin Header / Nav -->
    <header>
        <h2>Techkart Admin</h2>
        <nav>
            <ul>
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/products">Products</a></li>
                <li><a href="/admin/products/add">Add Product</a></li>
                <li><a href="/admin/orders">Orders</a></li>
                <li><a href="/admin/customers">Customers</a></li>
                <li><a href="/products" target="_blank">View Live Store</a></li>
                <li><a href="/admin/logout">Sign Out</a></li>
            </ul>
        </nav>
        <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle dark mode">&#127769;</button>
    </header>

    <main>
        <h1>Store Overview & Dashboard</h1>

        <!-- KPI Metrics -->
        <section class="kpi-metrics">
            <div>
                <h3>Total Revenue</h3>
                <p>₹<span id="kpi-revenue">0</span></p>
            </div>
            <div>
                <h3>Total Orders</h3>
                <p><span id="kpi-orders">0</span></p>
            </div>
            <div>
                <h3>Total Products</h3>
                <p><span id="kpi-products">0</span></p>
            </div>
            <div>
                <h3>Registered Customers</h3>
                <p><span id="kpi-customers">0</span></p>
            </div>
        </section>

        <!-- Recent Orders Table -->
        <section class="recent-orders">
            <h2>Recent Orders</h2>
            <table border="1" cellpadding="8" cellspacing="0">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="recent-orders-body">
                    <tr><td colspan="6">Loading...</td></tr>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Techkart Admin Control.</p>
    </footer>    <script src="/script.js" defer></script>
</body>

</html>