<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - Techkart Admin</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <h2>Techkart Admin</h2>
        <nav>
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/orders">Orders</a>
            <a href="/admin/customers">Customers</a>
        </nav>
    </header>

    <main>
        <h1>Add New Gadget</h1>

        <% if (typeof error !=='undefined' && error) { %>
            <p style="color: red;">
                <%= error %>
            </p>
            <% } %>
                <% if (typeof message !=='undefined' && message) { %>
                    <p style="color: green;">
                        <%= message %>
                    </p>
                    <% } %>

                        <form action="/admin/products/add" method="POST">
                            <!-- Basic Information -->
                            <fieldset>
                                <legend>Product Details</legend>
                                <div>
                                    <label for="name">Product Name:</label>
                                    <input type="text" id="name" name="name" required
                                        placeholder="e.g. Sony WH-1000XM5">
                                </div>
                                <div>
                                    <label for="brand">Brand:</label>
                                    <input type="text" id="brand" name="brand" required placeholder="e.g. Sony, Apple">
                                </div>
                                <div>
                                    <label for="category">Category:</label>
                                    <select id="category" name="category" required>
                                        <option value="smartphones">Smartphones</option>
                                        <option value="laptops">Laptops</option>
                                        <option value="audio">Audio</option>
                                        <option value="wearables">Wearables</option>
                                        <option value="gaming">Gaming</option>
                                        <option value="accessories">Accessories</option>
                                    </select>
                                </div>
                            </fieldset>

                            <!-- Pricing & Inventory -->
                            <fieldset>
                                <legend>Pricing & Inventory</legend>
                                <div>
                                    <label for="price">Selling Price (₹):</label>
                                    <input type="number" id="price" name="price" required placeholder="24999">
                                </div>
                                <div>
                                    <label for="originalPrice">Original Price / MRP (₹):</label>
                                    <input type="number" id="originalPrice" name="originalPrice" placeholder="29999">
                                </div>
                                <div>
                                    <label for="discount">Discount Percentage (%):</label>
                                    <input type="number" id="discount" name="discount" placeholder="10">
                                </div>
                                <div>
                                    <label for="stock">Stock Quantity:</label>
                                    <input type="number" id="stock" name="stock" required value="10" min="0">
                                </div>
                            </fieldset>

                            <!-- Media & Description -->
                            <fieldset>
                                <legend>Media & Description</legend>
                                <div>
                                    <label for="image">Product Image URL:</label>
                                    <input type="url" id="image" name="image"
                                        placeholder="https://example.com/image.jpg">
                                </div>
                                <div>
                                    <label for="description">Description:</label>
                                    <textarea id="description" name="description" rows="5"
                                        placeholder="Enter detailed product description..."></textarea>
                                </div>
                                <div>
                                    <input type="checkbox" id="featured" name="featured" checked>
                                    <label for="featured">Featured Product</label>
                                </div>
                            </fieldset>

                            <button type="submit">Add Product</button>
                            <a href="/admin/dashboard">Cancel</a>
                        </form>
    </main>

</body>

</html>