<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Techkart - E-Commerce Gadget Store</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Header / Navigation -->
    <header>
        <div class="logo">
            <a href="/">Techkart</a>
        </div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/products">All Products</a></li>
                <li><a href="/products?category=smartphones">Smartphones</a></li>
                <li><a href="/products?category=laptops">Laptops</a></li>
                <li><a href="/products?category=audio">Audio</a></li>
                <li><a href="/products?category=wearables">Wearables</a></li>
                <li><a href="/products?category=gaming">Gaming</a></li>
                <li><a href="/my-orders">My Orders</a></li>
            </ul>
        </nav>
        <div class="nav-actions">
            <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle dark mode">🌙</button>
            <!-- Search Form -->
            <form action="/products" method="GET">
                <input type="text" name="search" placeholder="Search gadgets..."
                    value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                <button type="submit">Search</button>
            </form>

            <a href="/cart">Cart (<%= (typeof cart !=='undefined' && cart && cart.items) ? cart.items.length : 0 %>)</a>

            <% if (typeof user !=='undefined' && user) { %>
                <span>Welcome, <%= user.name %></span>
                <a href="/logout">Logout</a>
                <% } else { %>
                    <a href="/login">Login</a>
                    <a href="/register">Register</a>
                    <% } %>
        </div>
    </header>

    <!-- Main Content -->
    <main>
        <!-- Hero Slideshow -->
        <section class="hero-slideshow" id="hero-slideshow">
            <div class="hero-slide active" style="background-image: linear-gradient(135deg, rgba(37,99,235,.82), rgba(124,58,237,.82)), url('https://images.unsplash.com/photo-1550009158-9ebf69173e03?auto=format&fit=crop&w=1600&q=80');">
                <span class="hero-badge">🔥 New Arrivals</span>
                <h1>Discover The Future Of Gadgets</h1>
                <p>Shop the latest smartphones, ultra laptops, noise-cancelling headphones, and gaming gear.</p>
                <a href="/products">Shop Now</a>
            </div>
            <div class="hero-slide" style="background-image: linear-gradient(135deg, rgba(8,145,178,.82), rgba(37,99,235,.82)), url('https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=1600&q=80');">
                <span class="hero-badge">📱 Trending</span>
                <h1>Next-Gen Smartphones Have Landed</h1>
                <p>Blazing fast performance, stunning displays, and cameras that capture every detail.</p>
                <a href="/products?category=smartphones">Explore Smartphones</a>
            </div>
            <div class="hero-slide" style="background-image: linear-gradient(135deg, rgba(124,58,237,.82), rgba(219,39,119,.82)), url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=80');">
                <span class="hero-badge">🎮 Level Up</span>
                <h1>Gear Built For Serious Gamers</h1>
                <p>Controllers, headsets, and accessories designed to keep you ahead of the competition.</p>
                <a href="/products?category=gaming">Shop Gaming</a>
            </div>

            <button class="hero-arrow hero-prev" id="hero-prev" aria-label="Previous slide">&#8249;</button>
            <button class="hero-arrow hero-next" id="hero-next" aria-label="Next slide">&#8250;</button>

            <div class="hero-dots" id="hero-dots">
                <button class="hero-dot active" data-slide="0" aria-label="Slide 1"></button>
                <button class="hero-dot" data-slide="1" aria-label="Slide 2"></button>
                <button class="hero-dot" data-slide="2" aria-label="Slide 3"></button>
            </div>
        </section>

        <!-- Categories Section -->
        <section class="categories">
            <h2>Shop By Category</h2>
            <div class="category-grid">
                <div class="category-item">
                    <a href="/products?category=smartphones">
                        <h3>Smartphones</h3>
                    </a>
                </div>
                <div class="category-item">
                    <a href="/products?category=laptops">
                        <h3>Laptops</h3>
                    </a>
                </div>
                <div class="category-item">
                    <a href="/products?category=audio">
                        <h3>Audio & Headphones</h3>
                    </a>
                </div>
                <div class="category-item">
                    <a href="/products?category=wearables">
                        <h3>Smartwatches</h3>
                    </a>
                </div>
                <div class="category-item">
                    <a href="/products?category=gaming">
                        <h3>Gaming Gear</h3>
                    </a>
                </div>
                <div class="category-item">
                    <a href="/products?category=accessories">
                        <h3>Accessories</h3>
                    </a>
                </div>
            </div>
        </section>

        <!-- Featured Products Section -->
        <section class="featured-products">
            <h2>Featured Gadgets</h2>
            <a href="/products">View All</a>

            <div class="product-grid">
                <p>Loading products...</p>
            </div>
        </section>

        <!-- Features / Trust Section -->
        <section class="features">
            <div class="feature-item">
                <h3>Free Delivery</h3>
                <p>On all orders above ₹999</p>
            </div>
            <div class="feature-item">
                <h3>1-Year Warranty</h3>
                <p>100% Genuine brand products</p>
            </div>
            <div class="feature-item">
                <h3>7 Days Replacement</h3>
                <p>Hassle-free replacement policy</p>
            </div>
            <div class="feature-item">
                <h3>24/7 Tech Support</h3>
                <p>Dedicated customer support</p>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-links">
            <div>
                <h4>Techkart</h4>
                <p>Your one-stop destination for next-gen technology and gadgets.</p>
            </div>
            <div>
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/products">Products</a></li>
                    <li><a href="/cart">Cart</a></li>
                    <li><a href="/my-orders">My Orders</a></li>
                </ul>
            </div>
            <div>
                <h4>Contact Us</h4>
                <p>Email: support@techkart.com</p>
                <p>Phone: +91 98765 43210</p>
            </div>
        </div>
        <p class="copyright">&copy; <%= new Date().getFullYear() %> Techkart. All rights reserved.</p>
    </footer>    <script src="/script.js" defer></script>
</body>

</html>