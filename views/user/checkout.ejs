<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(){try{var t=localStorage.getItem("techkart-theme")||"dark";document.documentElement.setAttribute("data-theme",t);}catch(e){document.documentElement.setAttribute("data-theme","dark");}})();</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - Techkart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <div class="logo">
            <a href="/">Techkart</a>
        </div>
        <nav>
            <a href="/cart">Back to Cart</a>
        </nav>
        <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle dark mode" title="Toggle dark mode">&#127769;</button>
    </header>

    <main>
        <h1>Checkout</h1>

            <form action="/checkout" method="POST">
                <!-- 1. Contact Information -->
                <fieldset>
                    <legend>1. Contact Information</legend>
                    <div>
                        <label for="email">Email Address:</label>
                        <input type="email" id="email" name="email" required
                            value="<%= (typeof user !== 'undefined' && user.email) ? user.email : '' %>">
                    </div>
                    <div>
                        <label for="phone">Phone Number:</label>
                        <input type="tel" id="phone" name="phone" required
                            value="<%= (typeof user !== 'undefined' && user.phone) ? user.phone : '' %>">
                    </div>
                </fieldset>

                <!-- 2. Shipping Address -->
                <fieldset>
                    <legend>2. Shipping Address</legend>
                    <div>
                        <label for="fullName">Full Name:</label>
                        <input type="text" id="fullName" name="fullName" required
                            value="<%= (typeof user !== 'undefined' && user.name) ? user.name : '' %>">
                    </div>
                    <div>
                        <label for="streetAddress">Street Address / House No:</label>
                        <input type="text" id="streetAddress" name="streetAddress" required>
                    </div>
                    <div>
                        <label for="city">City:</label>
                        <input type="text" id="city" name="city" required>
                    </div>
                    <div>
                        <label for="state">State:</label>
                        <input type="text" id="state" name="state" required>
                    </div>
                    <div>
                        <label for="pincode">PIN Code:</label>
                        <input type="text" id="pincode" name="pincode" required maxlength="6">
                    </div>
                </fieldset>

                <!-- 3. Payment Method -->
                <fieldset>
                    <legend>3. Payment Method</legend>
                    <div>
                        <input type="radio" id="pay-upi" name="paymentMethod" value="UPI" checked>
                        <label for="pay-upi">UPI / QR Code</label>
                    </div>
                    <div>
                        <input type="radio" id="pay-card" name="paymentMethod" value="Card">
                        <label for="pay-card">Credit / Debit Card</label>
                    </div>
                    <div>
                        <input type="radio" id="pay-netbanking" name="paymentMethod" value="NetBanking">
                        <label for="pay-netbanking">Net Banking</label>
                    </div>
                    <div>
                        <input type="radio" id="pay-cod" name="paymentMethod" value="COD">
                        <label for="pay-cod">Cash on Delivery (COD)</label>
                    </div>
                </fieldset>

                <!-- 4. Order Summary -->
                <fieldset>
                    <legend>Order Summary</legend>
                    <ul id="checkout-items"></ul>
                    <p>Subtotal: ₹<span id="checkout-subtotal">0</span></p>
                    <p>Shipping: <span id="checkout-shipping">₹0</span></p>
                    <h3>Total Amount: ₹<span id="checkout-total">0</span></h3>

                    <div>
                        <input type="checkbox" id="terms" required checked>
                        <label for="terms">I accept the terms and conditions</label>
                    </div>

                    <button type="submit">Place Order</button>
                </fieldset>
            </form>
    </main>

    <footer>
        <p>&copy; <%= new Date().getFullYear() %> Techkart. All rights reserved.</p>
    </footer>    <script src="/script.js" defer></script>
</body>

</html>